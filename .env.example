# Copy to .env.local and fill in values from your Supabase project.
# The anon key is public; NEVER put the Supabase service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# PayPal Checkout client ID is public. Keep the PayPal secret on the server only.
VITE_PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
